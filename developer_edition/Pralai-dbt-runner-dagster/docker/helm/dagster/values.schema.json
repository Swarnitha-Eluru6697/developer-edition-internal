{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dagster-dbt-runner values",
  "description": "Validated by `helm lint` / `helm template` / `helm install`. Governs how the Dagster webserver (an admin surface with no authentication of its own) may be exposed (DG-002); every other value is left unrestricted here.",
  "type": "object",
  "required": [
    "webserver",
    "networkPolicy"
  ],
  "properties": {
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "git": false
      }
    },
    "webserver": {
      "type": "object",
      "required": [
        "service",
        "ingress"
      ],
      "properties": {
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP"
              ],
              "description": "Only ClusterIP: LoadBalancer/NodePort would publish the unauthenticated Dagster UI directly."
            }
          }
        },
        "ingress": {
          "$ref": "#/definitions/ingress"
        }
      }
    },
    "tenant": {
      "type": "object",
      "properties": {
        "orgId": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "tenant.orgId names the dbt Runner Service (dbt-runner-<orgId>), so it must be usable in a DNS label: letters, digits, '-' and '_' only. Replace the placeholder with the real org id."
        }
      }
    },
    "codeServer": {
      "type": "object",
      "properties": {
        "gitCredentials": false
      }
    }
  },
  "if": {
    "properties": {
      "webserver": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "ingress"
        ]
      }
    },
    "required": [
      "webserver"
    ]
  },
  "then": {
    "properties": {
      "networkPolicy": {
        "properties": {
          "enabled": {
            "const": true,
            "description": "networkPolicy.enabled must stay true while the ingress is enabled: it is what keeps the webserver reachable only through the auth layer."
          }
        }
      }
    }
  },
  "definitions": {
    "ingress": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "auth": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "",
                "gateway",
                "oidc-proxy"
              ]
            },
            "fromNamespace": {
              "type": "string"
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "auth",
          "className",
          "host",
          "tls"
        ],
        "properties": {
          "className": {
            "type": "string",
            "minLength": 1,
            "description": "ingress.className is required: without it the Dagster UI would be published on whatever controller is the cluster default."
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "not": {
              "const": "dagster.example.com"
            },
            "description": "ingress.host must be set to the real host (the default is a placeholder)."
          },
          "tls": {
            "type": "array",
            "minItems": 1,
            "description": "ingress.tls is required: the admin UI is never published over plain HTTP."
          },
          "auth": {
            "type": "object",
            "required": [
              "mode",
              "fromNamespace"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "gateway",
                  "oidc-proxy"
                ],
                "description": "ingress.auth.mode must be 'gateway' (InAiEra gateway + admin-only policy) or 'oidc-proxy' (SSO via external-auth annotations). The Dagster UI has no authentication of its own."
              },
              "fromNamespace": {
                "type": "string",
                "minLength": 1,
                "description": "ingress.auth.fromNamespace is required: the namespace of the gateway / ingress controller, the only one the webserver pod will accept traffic from."
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "auth": {
                  "properties": {
                    "mode": {
                      "const": "oidc-proxy"
                    }
                  },
                  "required": [
                    "mode"
                  ]
                }
              },
              "required": [
                "auth"
              ]
            },
            "then": {
              "required": [
                "annotations"
              ],
              "properties": {
                "annotations": {
                  "type": "object",
                  "required": [
                    "nginx.ingress.kubernetes.io/auth-url",
                    "nginx.ingress.kubernetes.io/auth-signin"
                  ],
                  "properties": {
                    "nginx.ingress.kubernetes.io/auth-url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "nginx.ingress.kubernetes.io/auth-signin": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "description": "oidc-proxy mode needs the ingress-nginx external-auth annotations auth-url and auth-signin."
                }
              }
            }
          }
        ]
      }
    }
  }
}
