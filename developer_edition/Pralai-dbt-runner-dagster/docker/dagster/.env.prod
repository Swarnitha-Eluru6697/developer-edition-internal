# ---------------------------------------------------------------------------
# Production environment template — DO NOT commit with real secrets.
# In Kubernetes these values come from Secrets mounted as env vars.
# This file is a reference for manual docker / ECS deployments.
# ---------------------------------------------------------------------------

# --- Dagster metadata DB (RDS Postgres) ------------------------------------
DAGSTER_PG_HOST=<rds-endpoint>.rds.amazonaws.com
DAGSTER_PG_PORT=5432
DAGSTER_PG_DB=dagster
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=<from-secrets-manager>

# --- Dagster storage paths -------------------------------------------------
DAGSTER_COMPUTE_LOGS_DIR=/var/lib/dagster/compute-logs
DAGSTER_ARTIFACTS_DIR=/var/lib/dagster/artifacts

# --- Code server (Kubernetes ClusterIP service) ----------------------------
DAGSTER_CODE_SERVER_HOST=dagster-code-server
DAGSTER_CODE_SERVER_PORT=4000

# --- dbt Runner API --------------------------------------------------------
# In-cluster service URL (not internet-exposed)
DBT_RUNNER_BASE_URL=http://dbtrunner-svc:8082

# Dagster's own scoped identity at the runner (DBT-003). Must match SCHEDULER_JWT_SECRET in the dbt Runner
# deployment, and be a DIFFERENT secret from the runner's INTERNAL_SERVICE_TOKEN (which Dagster no longer holds).
SCHEDULER_JWT_SECRET=<from-secrets-manager>
ORG_ID=<this data plane's org id>

# --- Deployment target ------------------------------------------------------
DAGSTER_DEPLOYMENT_TARGET=prod
