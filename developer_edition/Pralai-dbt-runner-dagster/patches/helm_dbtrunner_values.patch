# SUPERSEDED (DG-001) — DO NOT APPLY. The runner chart now has scheduler.enabled, default TRUE, and refuses
# false without scheduler.externalOrchestrator. A default of false leaves production with no scheduler,
# because the Helm Dagster chart has no sensors.
#
# Patch for docker/helm/dbtrunner/values.yaml
# Add the scheduler.enabled field so the Helm chart can gate SCHEDULER_ENABLED.
#
# Apply in context:
#   Add this block inside the existing values.yaml after the `scheduler:` key.
#
# --- a/docker/helm/dbtrunner/values.yaml
# +++ b/docker/helm/dbtrunner/values.yaml
# @@ -after scheduler: @@

scheduler:
  pollIntervalSeconds: 30
  # ---------------------------------------------------------------------------
  # Phase 2: set enabled=false when Dagster owns scheduling.
  # Maps to SCHEDULER_ENABLED env var in the dbt Runner pod.
  # When false, only reconciler_loop and outbox_loop run under leader election.
  # ---------------------------------------------------------------------------
  enabled: false   # (old draft default - wrong for production, see the note above)
