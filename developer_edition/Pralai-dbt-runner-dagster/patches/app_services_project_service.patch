--- a/app/services/project_service.py
+++ b/app/services/project_service.py
@@ -after list_scheduled @@
+    async def list_scheduled_internal(self) -> list[Project]:
+        """Return ALL scheduled, enabled projects across all orgs.
+        For internal callers only (Dagster sensor). Mirrors list_scheduled()
+        but without the per-org filter."""
+        result = await self.db.execute(
+            select(Project)
+            .where(Project.schedule_enabled.is_(True))
+            .where(Project.schedule_cron.isnot(None))
+            .order_by(Project.id)
+        )
+        return list(result.scalars().all())
