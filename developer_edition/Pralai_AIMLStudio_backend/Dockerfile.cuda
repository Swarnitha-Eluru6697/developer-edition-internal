# syntax=docker/dockerfile:1
# CUDA runtime used to certify/run ML Studio native PyTorch + LLM fine-tuning workers.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip nodejs npm ca-certificates git libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-training.txt ./
RUN pip3 install --no-cache-dir -r requirements-training.txt
# @aadhyaanalyticsinc/gateway-auth comes from GitHub Packages (see Dockerfile):
# build with --secret id=npm_token,env=NODE_AUTH_TOKEN (or src=<file>).
COPY package*.json .npmrc ./
RUN --mount=type=secret,id=npm_token \
    NODE_AUTH_TOKEN="$(cat /run/secrets/npm_token)" npm ci --omit=dev
# Expects `npm run build` to have run on the host first — unlike Dockerfile,
# which compiles inside the image.
COPY dist ./dist
# Non-TypeScript files the compiled code loads by __dirname; tsc emits only .js,
# so these must be copied in beside it. schema.sql is read by initSchema() at
# startup, so without it the worker dies on boot with ENOENT.
COPY src/training ./dist/training
COPY src/db/schema.sql ./dist/db/schema.sql
CMD ["node", "dist/worker.js"]
