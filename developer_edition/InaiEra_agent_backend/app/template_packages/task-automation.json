{
  "package_version": "1",
  "manifest": {
    "key": "task-automation",
    "name": "Task-Automation",
    "version": "1.0.2",
    "type": "App",
    "category": "Operations",
    "vertical": null,
    "tags": [],
    "desc": "Triggers, multi-step tool chains, human-in-the-loop approvals.",
    "first_party": true,
    "app_type": "workflow"
  },
  "flow": {
    "nodes": [
      {
        "id": "t1",
        "type": "trigger",
        "x": 40,
        "y": 140,
        "sub": "webhook/schedule",
        "config": {
          "trigger_type": "webhook"
        }
      },
      {
        "id": "t2",
        "type": "gov",
        "x": 200,
        "y": 140,
        "sub": "entitlement gate",
        "config": {}
      },
      {
        "id": "t3",
        "type": "llm",
        "x": 360,
        "y": 140,
        "sub": "plan action",
        "config": {
          "mode": "agentic",
          "model": "Claude Sonnet 5",
          "step_limit": 12,
          "guardrail_profile": "Standard (input + output)"
        }
      },
      {
        "id": "t4",
        "type": "tool",
        "x": 520,
        "y": 140,
        "sub": "action connector",
        "config": {
          "catalog_object": "pg_sales.public.orders"
        }
      },
      {
        "id": "t5",
        "type": "hitl",
        "x": 680,
        "y": 140,
        "sub": "approval",
        "config": {
          "delivery_methods": [
            "web_app"
          ],
          "form_content": "Approve this task before completion?",
          "actions": [
            {
              "id": "approve",
              "label": "Approve"
            },
            {
              "id": "reject",
              "label": "Reject"
            }
          ]
        }
      },
      {
        "id": "t6",
        "type": "output",
        "x": 840,
        "y": 140,
        "sub": "workflow result",
        "config": {
          "variables": [
            {
              "name": "result",
              "expr": "{{tool_output}}"
            }
          ]
        }
      }
    ],
    "edges": [
      {
        "id": "te1",
        "source": "t1",
        "target": "t2",
        "source_handle": null
      },
      {
        "id": "te2",
        "source": "t2",
        "target": "t3",
        "source_handle": null
      },
      {
        "id": "te3",
        "source": "t3",
        "target": "t4",
        "source_handle": null
      },
      {
        "id": "te4",
        "source": "t4",
        "target": "t5",
        "source_handle": null
      },
      {
        "id": "te5",
        "source": "t5",
        "target": "t6",
        "source_handle": null
      }
    ]
  },
  "requirements": {
    "node_types": [
      "gov",
      "hitl",
      "llm",
      "output",
      "tool",
      "trigger"
    ],
    "knowledge_bases": [],
    "catalog_objects": [
      "pg_sales.public.orders"
    ],
    "tools": [],
    "models": [
      "Claude Sonnet 5"
    ],
    "env_vars": [],
    "review": []
  }
}
