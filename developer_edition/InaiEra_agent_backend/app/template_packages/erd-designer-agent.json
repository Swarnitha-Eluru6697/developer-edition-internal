{
  "package_version": "1",
  "manifest": {
    "key": "erd-designer-agent",
    "name": "ERD Designer Agent",
    "version": "1.0.0",
    "type": "Data",
    "category": "Data",
    "vertical": null,
    "tags": [],
    "desc": "ERD generation from requirements, schema diffing, migration scripts.",
    "first_party": true
  },
  "flow": {
    "nodes": [
      {
        "id": "t1",
        "type": "trigger",
        "x": 40,
        "y": 140,
        "sub": "user input",
        "config": {}
      },
      {
        "id": "t2",
        "type": "gov",
        "x": 200,
        "y": 140,
        "sub": "entitlement gate",
        "config": {}
      },
      {
        "id": "t3",
        "type": "retrieval",
        "x": 360,
        "y": 140,
        "sub": "existing schema",
        "config": {
          "knowledge_bases": [],
          "top_k": 10
        }
      },
      {
        "id": "t4",
        "type": "llm",
        "x": 520,
        "y": 140,
        "sub": "design ERD",
        "config": {
          "mode": "agentic",
          "model": "Claude Sonnet 5",
          "step_limit": 15,
          "guardrail_profile": "Strict"
        }
      },
      {
        "id": "t5",
        "type": "template",
        "x": 680,
        "y": 140,
        "sub": "render migration",
        "config": {
          "template": "-- Migration for {{trigger_input}}\n{{output}}"
        }
      },
      {
        "id": "t6",
        "type": "respond",
        "x": 840,
        "y": 140,
        "sub": "ERD + SQL",
        "config": {
          "format": "markdown",
          "streaming": true
        }
      }
    ],
    "edges": [
      {
        "id": "te1",
        "source": "t1",
        "target": "t2",
        "source_handle": null
      },
      {
        "id": "te2",
        "source": "t2",
        "target": "t3",
        "source_handle": null
      },
      {
        "id": "te3",
        "source": "t3",
        "target": "t4",
        "source_handle": null
      },
      {
        "id": "te4",
        "source": "t4",
        "target": "t5",
        "source_handle": null
      },
      {
        "id": "te5",
        "source": "t5",
        "target": "t6",
        "source_handle": null
      }
    ]
  },
  "requirements": {
    "node_types": [
      "gov",
      "llm",
      "respond",
      "retrieval",
      "template",
      "trigger"
    ],
    "knowledge_bases": [],
    "catalog_objects": [],
    "tools": [],
    "models": [
      "Claude Sonnet 5"
    ],
    "env_vars": [],
    "review": []
  }
}
