# ════════════════════════════════════════════════════════════════════════════
#  InaiEra DataConnect — infra/ environment overrides
#
#  Every value here already has a working default baked into the compose file,
#  so this file is OPTIONAL. Copy it to `.env` in this directory only when the
#  target machine already owns one of the ports below.
#
#      cp .env.example .env
# ════════════════════════════════════════════════════════════════════════════

# ── Host ports ──────────────────────────────────────────────────────────────
# Frontend MFE. The Control Portal shell loads /assets/remoteEntry.js from here.
FRONTEND_PORT=3000

# Backend API. Keep these two in lockstep: the frontend's standalone default
# base URL is hardcoded to localhost:8001 in src/context/AppContext.tsx, so
# changing this without editing that file (or repointing via the UI's Settings
# page, which persists to localStorage) leaves the UI talking to nothing.
BACKEND_PORT=8001

# Shift these if a native Postgres/Redis already owns the standard ports.
POSTGRES_PORT=5432
REDIS_PORT=6379

# Kafka's host-facing port. Set it here rather than hand-editing the port
# mapping: the compose file echoes this value into KAFKA_ADVERTISED_LISTENERS,
# which is the address host clients are told to reconnect on. Change the
# mapping alone and every host producer/consumer breaks on the second hop.
KAFKA_PORT=9092

SCHEMA_REGISTRY_PORT=8081
KAFKA_CONNECT_PORT=8083
KAFKA_UI_PORT=8090
PROMETHEUS_PORT=9099

# ── Database credentials ────────────────────────────────────────────────────
# Used to build DATACONNECT_DATABASE_URL, so the backend follows any change.
POSTGRES_DB=dataconnect
POSTGRES_USER=dataconnect
POSTGRES_PASSWORD=dataconnect

# ── Frontend source location ────────────────────────────────────────────────
# Path to the frontend clone, relative to this infra/ directory. Override if
# your checkout is named differently.
FRONTEND_DIR=../../InaiEra_DataConnect_Frontend
