.DS_Store
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
# coverage.py output: a SQLite database of which lines ran, keyed by absolute paths on the machine that ran the tests.
# It is rewritten by every test run, so it is never source and never belongs in git.
.coverage
.coverage.*
htmlcov/
coverage.xml
.venv/
*.egg-info/
dist/
build/
node_modules/
.vite/
coverage/
*.log
# large / local-only — do not push
backend.zip
.idea/
# the frontend is its own repo (frontend-chages); the old React app is dead code
frontend/
frontend-chages/

# Connector-test runtime data under infra/file-connector-data (generated by the File Chunk, SpoolDir and Local File
# connector tests: random binary files, chunk files, merged output). The few sample files already tracked there stay.
infra/file-connector-data/chunk-*/
infra/file-connector-data/chunk-out/
infra/file-connector-data/sink-out/
infra/file-connector-data/spool-in/

# generated by infra/test-backends.py init (self-signed certs and emulator config for the connector test backends)
infra/test-backends-data/

# generated by `make sbom` (CI uploads it as an artifact instead)
sbom/
.hypothesis/
