# ──────────────────────────────────────────────────────────────
#  InaiEra DataConnect — Environment Variables
#  Copy to .env and fill in values for your environment.
# ──────────────────────────────────────────────────────────────

# Application
DATACONNECT_ENV=development                  # development | staging | production
DATACONNECT_API_PREFIX=/api/v1/dataconnect
DATACONNECT_LOG_LEVEL=INFO

# Database (PostgreSQL + asyncpg)
DATACONNECT_DATABASE_URL=postgresql+asyncpg://dataconnect:dataconnect@localhost:5432/dataconnect
DATACONNECT_DB_POOL_SIZE=10
DATACONNECT_DB_MAX_OVERFLOW=20

# Kafka Connect
DATACONNECT_KAFKA_CONNECT_URL=http://localhost:8083
DATACONNECT_KAFKA_REST_PROXY_URL=http://localhost:8082
DATACONNECT_TOPIC_SOFT_LIMIT=180

# Feature Flags
DATACONNECT_RUNTIME_DEPLOY_ENABLED=false
DATACONNECT_SCHEMA_DRIFT_AUTO_APPROVE=false

# CORS
DATACONNECT_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Security (JWT — wired when RBAC is added)
DATACONNECT_JWT_SECRET=CHANGEME_USE_A_STRONG_SECRET
DATACONNECT_JWT_ALGORITHM=HS256
DATACONNECT_JWT_EXPIRE_MINUTES=60

# Local development ONLY (DATACONNECT_ENV=development and TRUST_ENVOY_HEADERS not "true" — see
# app/core/gateway.py): serve every request as one fixed principal holding these permissions
# ("all", or a comma list of dataconnect:* IDs from permissions.json). Empty = no development principal.
# Startup refuses a non-empty value in any other environment. No request header is ever trusted for it.
DATACONNECT_DEV_PERMISSIONS=
DATACONNECT_DEV_USER=dev-user
DATACONNECT_DEV_TENANT=org_1001

# /metrics is behind the gateway unless this is true (for an in-cluster Prometheus that bypasses Envoy).
DATACONNECT_METRICS_PUBLIC=false

# Secrets Backend
DATACONNECT_SECRET_BACKEND=env             # env | postgres (the same thing: AES-256-GCM rows in PostgreSQL). "vault" is rejected at startup.

# Cache / Queue
DATACONNECT_REDIS_URL=redis://localhost:6379/0

# Gateway auth (Gate 1 — see app/core/gateway.py)
# The service only trusts identity headers when they arrive through Envoy, proven
# by the per-data-plane gateway secret Envoy injects (append:false). With these
# unset, any request without the secret is rejected 401 "request did not come
# through the gateway". Read by the gateway-auth package from THESE exact env names.
TRUST_ENVOY_HEADERS=true
ENVOY_INTERNAL_SECRET=CHANGEME_PER_DATA_PLANE_SECRET   # must match Envoy's request_headers_to_add on this route

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1/dataconnect
VITE_ORG_ID=org_1001

# GAP-01: AES-256-GCM key (32 bytes, base64) encrypting connection credentials at rest. REQUIRED outside
# development. Generate: python -c "from app.services.secret_crypto import generate_key; print(generate_key())"
# Rotate: set a new key + id here and list the old as DATACONNECT_SECRET_ENCRYPTION_PREVIOUS_KEYS=k1:<old-key>
DATACONNECT_SECRET_ENCRYPTION_KEY=
DATACONNECT_SECRET_ENCRYPTION_KEY_ID=k1
DATACONNECT_SECRET_ENCRYPTION_PREVIOUS_KEYS=
