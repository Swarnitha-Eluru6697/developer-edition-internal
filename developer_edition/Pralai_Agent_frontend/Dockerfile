# Real frontend production image (§0.81, GAP_REPORT) — the actual fix
# for the reported gap: docker-compose.yml's own stack had real
# Postgres/Temporal/Temporal-UI/worker services but no real api or
# frontend service at all — fine for local dev (both run directly on
# the host, `npm run dev` + `uvicorn ... --reload`), but the
# repository itself represented no complete, deployable service
# topology. This is a real, standard two-stage build: stage one
# genuinely runs `npm run build` (tsc -b && vite build — see
# package.json), producing the real, static production bundle in
# dist/; stage two serves those static files via nginx (nginx.conf,
# this same directory), which proxies nothing — the API is reached
# through Envoy, never through this container.
# node:24, not node:20 — this project's own dev toolchain requires it.
# vitest@4, jsdom@30 and @testing-library/jest-dom@7 all declare
# `engines.node >= 22`, and npm 10 (which node:20 ships) resolves
# vitest@^4's esbuild dependency to a different tree than npm 11 does,
# so a package-lock.json generated by a current npm can never satisfy
# `npm ci` here. Matching the major npm version keeps the lock file
# authoritative for both local installs and this image.
FROM node:24-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Optional build-time switch: VITE_UCS_ENABLED=false hides the Unified Catalog access step.
ARG VITE_UCS_ENABLED
ENV VITE_UCS_ENABLED=$VITE_UCS_ENABLED
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
