# InaiEra Developer Edition: settings for the root docker-compose.yml.
# Every value marked <generate> must be a unique random string (the install script
# will generate them; do not reuse one secret for two settings: the runners refuse that).

# Optional: default LLM provider key for Agents (keys can also be added in the app).
ANTHROPIC_API_KEY=

# Databases (hex only: they are embedded in connection URLs)
DE_POSTGRES_PASSWORD=<generate>
DE_DB_PASSWORD=<generate>
DE_MINIO_USER=inaiera
DE_MINIO_PASSWORD=<generate>

# Gateway <-> every backend (x-inaiera-gateway-secret / ENVOY_INTERNAL_SECRET)
GATEWAY_SECRET=<generate>

# Encryption keys: 32-byte url-safe base64 (Fernet format)
AGENTS_SECRETS_ENCRYPTION_KEY=<generate>
DATACONNECT_SECRET_ENCRYPTION_KEY=<generate>

# Workspace / Data Quality / dbt-runner / Flink runner / Dagster service secrets
DBTRUNNER_INTERNAL_TOKEN=<generate>
DBTRUNNER_DELEGATION_JWT_SECRET=<generate>
DBTRUNNER_SCHEDULER_JWT_SECRET=<generate>
DBTRUNNER_SERVICE_JWT_SECRET=<generate>
RUNNER_JOB_JWT_SECRET=<generate>
FLINKSQL_INTERNAL_TOKEN=<generate>
FLINKSQL_DELEGATION_JWT_SECRET=<generate>
DQ_INBOUND_SERVICE_JWT_SECRET=<generate>
WORKSPACE_DQ_DELEGATION_JWT_SECRET=<generate>
DQ_TO_DBTRUNNER_DELEGATION_JWT_SECRET=<generate>
DQ_TO_FLINKSQL_DELEGATION_JWT_SECRET=<generate>

# Optional host ports (all bound to 127.0.0.1)
DE_PG_PORT=55432
DE_KAFKA_PORT=9092
DE_FLINK_UI_PORT=8181
DE_DAGSTER_PORT=3001

# The single local user shown on the dashboard
DE_USER_NAME=Developer
DE_USER_EMAIL=developer@localhost
DE_ORGANIZATION=Developer Edition

# Registration service (sign-up, sign-in, license check-in). Local admin portal backend by default;
# production: https://register.<domain>/v1
DE_REGISTRATION_URL=http://localhost:4102/v1
# Country / city lookup at sign-up and sign-in (IP geolocation, called from the browser).
# Uncomment and leave empty to send only the time zone and locale.
# DE_GEO_URL=https://get.geojs.io/v1/ip/geo.json
DE_APP_VERSION=v1.0.0
# Filled in by devedition/install-identity.sh (install.sh runs it):
# DE_INSTALL_ID, DE_FINGERPRINT_HASH, DE_OS
