# Developer Edition gateway (generated from each product's permissions.json).
# One user, no Keycloak: every API call is stamped with the single developer's identity
# and the shared gateway secret, which the backends check (TRUST_ENVOY_HEADERS=true).
# ${GATEWAY_SECRET} and ${DQ_BEARER} are filled in by the nginx image at start-up.
# Ports are published on 127.0.0.1 only (docker-compose.yml), so nothing is reachable
# from other machines.

resolver 127.0.0.11 ipv6=off valid=10s;
client_max_body_size 512m;
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_read_timeout 600s;

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# ── 8080: launcher ─────────────────────────────────────────────────────────
server {
  listen 8080;
  root /usr/share/nginx/html;
  # The single local user shown on the dashboard (DE_USER_* in .env).
  location = /me.json {
    default_type application/json;
    add_header Cache-Control "no-store";
    return 200 '{"name":"${DE_USER_NAME}","email":"${DE_USER_EMAIL}","organization":"${DE_ORGANIZATION}","role":"Developer","limits":{"connectors":"${DE_LIMIT_CONNECTORS}","workspaces":"${DE_LIMIT_WORKSPACES}","deployments":"${DE_LIMIT_DEPLOYMENTS}"},"links":{"slack":"${DE_SLACK_URL}","docs":"${DE_DOCS_URL}","issues":"${DE_ISSUES_URL}"},"ports":{"postgres":"${DE_PG_PORT}","kafka":"${DE_KAFKA_PORT}","flink":"${DE_FLINK_UI_PORT}","dagster":"${DE_DAGSTER_PORT}"}}';
  }

  # This installation's identity and where the hosted Registration service is (sign-up, sign-in,
  # check-in). The shell calls that service directly over HTTPS; its CORS allows this origin.
  location = /install.json {
    default_type application/json;
    add_header Cache-Control "no-store";
    return 200 '{"install_id":"${DE_INSTALL_ID}","fingerprint_hash":"${DE_FINGERPRINT_HASH}","os":"${DE_OS}","app_version":"${DE_APP_VERSION}","registration_url":"${DE_REGISTRATION_URL}","license_public_key":"${DE_LICENSE_PUBLIC_KEY}","license_version":"${DE_LICENSE_VERSION}","license_url":"${DE_LICENSE_URL}"}';
  }

  # Dashboard status: live health probes of every product and infrastructure service.
  # Read-only, short timeouts so one stopped container never stalls the page.
  location /probe/ {
    limit_except GET { deny all; }
    proxy_connect_timeout 2s; proxy_read_timeout 5s;
    add_header Cache-Control "no-store";
    proxy_set_header Authorization "";
    location = /probe/dataconnect     { set $up dataconnect-api:8000;    proxy_pass http://$up/api/v1/dataconnect/health/ready; }
    location = /probe/workspace       { set $up workspace:8080;          proxy_pass http://$up/healthz; }
    location = /probe/ucs             { set $up ucs-api:8000;            proxy_pass http://$up/health; }
    location = /probe/agents          { set $up agents-api:8000;         proxy_pass http://$up/readyz; }
    location = /probe/mlstudio        { set $up mlstudio-api:4000;       proxy_pass http://$up/api/health; }
    location = /probe/dataquality     { set $up dataquality:8086;        proxy_pass http://$up/healthz; }
    location = /probe/kafka-connect   { set $up kafka-connect:8083;      proxy_pass http://$up/; }
    location = /probe/schema-registry { set $up schema-registry:8081;    proxy_pass http://$up/subjects; }
    location = /probe/gravitino       { set $up gravitino:8090;          proxy_pass http://$up/api/version; }
    location = /probe/dagster         { set $up dagster-webserver:3000;  proxy_pass http://$up/server_info; }
    location = /probe/flink           { set $up flinksql-runner:8081;    proxy_pass http://$up/overview; }
    location = /probe/minio           { set $up minio:9000;              proxy_pass http://$up/minio/health/live; }
    return 404;
  }

  # Dashboard connectors: DataConnect's API, read-only (same single-user dev mode as :8101).
  location /dataconnect-api/ {
    limit_except GET { deny all; }
    set $up dataconnect-api:8000;
    rewrite ^/dataconnect-api/(.*)$ /api/v1/dataconnect/$1 break;
    proxy_set_header x-user-name ""; proxy_set_header x-user-id ""; proxy_set_header x-user-groups "";
    proxy_set_header x-user-roles ""; proxy_set_header x-user-permissions ""; proxy_set_header x-tenant-id "";
    proxy_set_header x-inaiera-gateway-secret "";
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s; proxy_read_timeout 10s;
    add_header Cache-Control "no-store";
    proxy_pass http://$up;
  }

  # Dashboard counts (read-only): Workspace jobs/projects, Agents, ML Studio deployments.
  location /workspace-api/ {
    limit_except GET { deny all; }
    set $up workspace:8080;
    rewrite ^/workspace-api/(.*)$ /api/v1/$1 break;
    proxy_set_header x-user-name        "${DE_USER_NAME}";
    proxy_set_header x-user-id          "7d3f6a2e-4b1c-4e8a-9f20-5c6d7e8f9a01";
    proxy_set_header x-user-groups      "WyJkZXZlbG9wZXJzIl0=";
    proxy_set_header x-user-roles       "WyJhZG1pbiIsImRldmVsb3BlciJd";
    proxy_set_header x-user-permissions "";
    proxy_set_header x-tenant-id        "local-dev";
    proxy_set_header x-inaiera-gateway-secret "${GATEWAY_SECRET}";
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s; proxy_read_timeout 10s;
    add_header Cache-Control "no-store";
    proxy_pass http://$up;
  }
  location /agents-api/ {
    limit_except GET { deny all; }
    set $up agents-api:8000;
    rewrite ^/agents-api/(.*)$ /api/$1 break;
    proxy_set_header x-user-name        "${DE_USER_NAME}";
    proxy_set_header x-user-id          "7d3f6a2e-4b1c-4e8a-9f20-5c6d7e8f9a01";
    proxy_set_header x-user-groups      "WyJkZXZlbG9wZXJzIl0=";
    proxy_set_header x-user-roles       "WyJhZG1pbiIsImRldmVsb3BlciJd";
    proxy_set_header x-user-permissions "";
    proxy_set_header x-tenant-id        "prod_metalake";
    proxy_set_header x-inaiera-gateway-secret "${GATEWAY_SECRET}";
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s; proxy_read_timeout 10s;
    add_header Cache-Control "no-store";
    proxy_pass http://$up;
  }
  location /mlstudio-api/ {
    limit_except GET { deny all; }
    set $up mlstudio-api:4000;
    rewrite ^/mlstudio-api/(.*)$ /api/$1 break;
    proxy_set_header x-user-name        "${DE_USER_NAME}";
    proxy_set_header x-user-id          "7d3f6a2e-4b1c-4e8a-9f20-5c6d7e8f9a01";
    proxy_set_header x-user-groups      "WyJkZXZlbG9wZXJzIl0=";
    proxy_set_header x-user-roles       "WyJhZG1pbiIsImRldmVsb3BlciJd";
    proxy_set_header x-user-permissions "";
    proxy_set_header x-tenant-id        "default";
    proxy_set_header x-inaiera-gateway-secret "${GATEWAY_SECRET}";
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s; proxy_read_timeout 10s;
    add_header Cache-Control "no-store";
    proxy_pass http://$up;
  }

  location / { add_header Cache-Control "no-cache"; try_files $uri /index.html; }
}

# ── 8101: DataConnect (backend runs in single-user development mode) ──────
server {
  listen 8101;
  location /api/v1/dataconnect/ {
    set $up dataconnect-api:8000;
    # Never trust identity headers sent by the browser.
    proxy_set_header x-user-name ""; proxy_set_header x-user-id ""; proxy_set_header x-user-groups "";
    proxy_set_header x-user-roles ""; proxy_set_header x-user-permissions ""; proxy_set_header x-tenant-id "";
    proxy_set_header x-inaiera-gateway-secret "";
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://$up;
    proxy_buffering off;
  }
  location / { set $up dataconnect-web:5001; proxy_pass http://$up; }
}

# ── 8102: Transformer (Workspace) ─────────────────────────────────────────
server {
  listen 8102;
  # Static runtime config: no control-plane login URL in Developer Edition.
  location = /config.json {
    default_type application/json;
    return 200 '{"controlPlaneLoginUrl":"http://localhost:8080/"}';
  }
  location /api/ {
    set $up workspace:8080;
    proxy_set_header x-user-name        "${DE_USER_NAME}";
    proxy_set_header x-user-id          "7d3f6a2e-4b1c-4e8a-9f20-5c6d7e8f9a01";
    proxy_set_header x-user-groups      "WyJkZXZlbG9wZXJzIl0=";
    proxy_set_header x-user-roles       "WyJhZG1pbiIsImRldmVsb3BlciJd";
    proxy_set_header x-user-permissions "";
    proxy_set_header x-tenant-id        "local-dev";
    proxy_set_header x-inaiera-gateway-secret "${GATEWAY_SECRET}";
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://$up;
    proxy_buffering off;
  }
  location /ws/ {
    set $up workspace:8080;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://$up;
  }
  location / { set $up workspace-web:80; proxy_pass http://$up; }
}

# ── 8103: UCS ─────────────────────────────────────────────────────────────
server {
  listen 8103;
  location /api/ {
    set $up ucs-api:8000;
    proxy_set_header x-user-name        "${DE_USER_NAME}";
    proxy_set_header x-user-id          "7d3f6a2e-4b1c-4e8a-9f20-5c6d7e8f9a01";
    proxy_set_header x-user-groups      "WyJkZXZlbG9wZXJzIl0=";
    proxy_set_header x-user-roles       "WyJhZG1pbiIsImRldmVsb3BlciJd";
    proxy_set_header x-user-permissions "";
    proxy_set_header x-tenant-id        "default";
    proxy_set_header x-inaiera-gateway-secret "${GATEWAY_SECRET}";
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://$up;
  }
  location = /health { set $up ucs-api:8000; proxy_pass http://$up/health; }
  location = /ready  { set $up ucs-api:8000; proxy_pass http://$up/ready; }
  # Data Quality validates a control-plane JWT; the dev JWKS stub mints it (see 15-dq-token.envsh).
  location /dq-api/ {
    set $up dataquality:8086;
    rewrite ^/dq-api/(.*)$ /$1 break;
    proxy_set_header Authorization "Bearer ${DQ_BEARER}";
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://$up;
  }
  # The UCS image sends no Cache-Control for its pages, so browsers kept an old index.html (and its old
  # bundle) after a rebuild. Pages are revalidated every load; hashed /assets/ files keep the image's caching.
  location / { set $up ucs-web:80; proxy_pass http://$up; proxy_hide_header Cache-Control; add_header Cache-Control "no-cache" always; }
  location /assets/ { set $up ucs-web:80; proxy_pass http://$up; }
}

# ── 8104: Agents ──────────────────────────────────────────────────────────
server {
  listen 8104;
  location ~ ^/(api/|mcp|embed\.js) {
    set $up agents-api:8000;
    proxy_set_header x-user-name        "${DE_USER_NAME}";
    proxy_set_header x-user-id          "7d3f6a2e-4b1c-4e8a-9f20-5c6d7e8f9a01";
    proxy_set_header x-user-groups      "WyJkZXZlbG9wZXJzIl0=";
    proxy_set_header x-user-roles       "WyJhZG1pbiIsImRldmVsb3BlciJd";
    proxy_set_header x-user-permissions "";
    proxy_set_header x-tenant-id        "prod_metalake";
    proxy_set_header x-inaiera-gateway-secret "${GATEWAY_SECRET}";
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://$up;
    proxy_buffering off;          # run/stream responses
  }
  location /mlstudio-api/ {
    set $up mlstudio-api:4000;
    rewrite ^/mlstudio-api/(.*)$ /api/$1 break;
    proxy_set_header x-user-name        "${DE_USER_NAME}";
    proxy_set_header x-user-id          "7d3f6a2e-4b1c-4e8a-9f20-5c6d7e8f9a01";
    proxy_set_header x-user-groups      "WyJkZXZlbG9wZXJzIl0=";
    proxy_set_header x-user-roles       "WyJhZG1pbiIsImRldmVsb3BlciJd";
    proxy_set_header x-user-permissions "";
    proxy_set_header x-tenant-id        "default";
    proxy_set_header x-inaiera-gateway-secret "${GATEWAY_SECRET}";
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://$up;
  }
  location / { set $up agents-web:80; proxy_pass http://$up; }
}

# ── 8105: ML Studio ───────────────────────────────────────────────────────
server {
  listen 8105;
  location /api/ {
    set $up mlstudio-api:4000;
    proxy_set_header x-user-name        "${DE_USER_NAME}";
    proxy_set_header x-user-id          "7d3f6a2e-4b1c-4e8a-9f20-5c6d7e8f9a01";
    proxy_set_header x-user-groups      "WyJkZXZlbG9wZXJzIl0=";
    proxy_set_header x-user-roles       "WyJhZG1pbiIsImRldmVsb3BlciJd";
    proxy_set_header x-user-permissions "";
    proxy_set_header x-tenant-id        "default";
    proxy_set_header x-inaiera-gateway-secret "${GATEWAY_SECRET}";
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://$up;
