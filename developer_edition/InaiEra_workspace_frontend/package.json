{
  "name": "@inaiera/workspace-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "InAiEra Workspace frontend contract — Redux store, RTK Query API client, WebSocket middleware, and Monaco editor wrapper. Bundled into the same container as the backend and served from / under orgid.app.workspace.inaiera.com.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "codegen:api": "openapi-typescript openapi/workspace.v0.1.0.json -o src/api/generated/workspace-schema.ts --default-non-nullable false",
    "codegen:rbac": "node scripts/generate-rbac.mjs",
    "codegen:rbac:check": "node scripts/generate-rbac.mjs --check",
    "codegen:check": "npm run codegen:api && git diff --exit-code -- src/api/generated/workspace-schema.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@reduxjs/toolkit": "^2.2.0",
    "@tabler/icons-webfont": "3.5.0",
    "monaco-editor": "^0.46.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.5.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^15.4.0",
    "jsdom": "^24.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.4.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
