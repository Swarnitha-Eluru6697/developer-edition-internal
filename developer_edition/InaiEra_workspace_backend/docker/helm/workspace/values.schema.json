{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inaiera.com/schemas/workspace-helm-values-v1.json",
  "title": "Workspace chart \u2014 cross-service integration contract",
  "description": "Validated automatically by `helm lint` / `helm template` / `helm install`. Governs the gateway trust contract (W-001), the dbtRunner and flinkSqlRunner (incl. their delegation secrets, X-001), dq (incl. its scoped-JWT secret, W-002) and ucs integration contract (WS-CFG-004) the secrets vault (WS-SEC-002), the execution worker (WS-EXEC-005), and egress/NetworkPolicy (WS-009) \u2014 every other value in this chart is left unrestricted here.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "integrationsContractVersion",
    "dbtRunner",
    "flinkSqlRunner",
    "dq",
    "ucs",
    "secrets",
    "worker",
    "egress",
    "networkPolicy",
    "gateway"
  ],
  "properties": {
    "integrationsContractVersion": {
      "type": "integer",
      "const": 1,
      "description": "Bump this whenever the shape of dbtRunner/flinkSqlRunner/dq/ucs changes incompatibly."
    },
    "dbtRunner": {
      "allOf": [
        {
          "$ref": "#/definitions/integration"
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "delegationJwtSecretRef"
            ],
            "properties": {
              "delegationJwtSecretRef": {
                "$ref": "#/definitions/secretRef",
                "description": "Secret holding the key that signs the short-lived delegated JWT Workspace presents to the dbt Runner (X-001). Mounted as DBTRUNNER_DELEGATION_JWT_SECRET; must equal the runner's DELEGATION_JWT_SECRET. Required when dbtRunner is enabled: Workspace no longer forwards the user's own credential."
              }
            }
          }
        }
      ]
    },
    "flinkSqlRunner": {
      "allOf": [
        {
          "$ref": "#/definitions/integration"
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "delegationJwtSecretRef"
            ],
            "properties": {
              "delegationJwtSecretRef": {
                "$ref": "#/definitions/secretRef",
                "description": "Secret holding the key that signs the short-lived delegated JWT Workspace presents to the FlinkSQL Runner (X-001). Mounted as FLINKSQL_DELEGATION_JWT_SECRET; must equal the runner's DELEGATION_JWT_SECRET. Required when flinkSqlRunner is enabled."
              }
            }
          }
        }
      ]
    },
    "dq": {
      "$ref": "#/definitions/dq"
    },
    "ucs": {
      "$ref": "#/definitions/integration"
    },
    "secrets": {
      "$ref": "#/definitions/secrets"
    },
    "worker": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "replicas",
        "concurrency",
        "leaseSeconds"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "description": "At least one worker must run, or submitted executions never start."
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "pollIntervalSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "leaseSeconds": {
          "type": "integer",
          "minimum": 5
        }
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "gitAllowedHosts",
        "connectionAllowedNetworks"
      ],
      "properties": {
        "gitAllowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gitlabHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "connectionAllowedNetworks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "connectionAllowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "connectionAllowPublic": {
          "type": "boolean"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressControllerNamespace": {
          "type": "string",
          "minLength": 1
        },
        "egressNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "egressCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "allowPublicHttps": {
          "type": "boolean"
        }
      }
    },
    "gateway": {
      "$ref": "#/definitions/gateway"
    },
    "dataPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "enum": [
            "off",
            "audit",
            "enforce"
          ],
          "description": "off | audit (record, never block) | enforce (UCS denial = 403, UCS unavailable = 503). enforce requires ucs.enabled."
        },
        "enforcedActions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(dbt|flink|dq|dataset|git)\\.[a-z.]+$"
          },
          "description": "Narrow enforce to these product actions (empty = all)."
        },
        "catalog": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "profile": {
          "enum": [
            "production-governed",
            "development-ungoverned"
          ],
          "description": "production-governed (default) requires UCS; development-ungoverned is unsupported for production."
        },
        "acknowledgeUnsupportedForProduction": {
          "type": "boolean"
        }
      }
    }
  },
  "definitions": {
    "secretRef": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "key"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        },
        "internalTokenSecretRef": {
          "type": "object"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "url",
          "internalTokenSecretRef"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "Required non-empty in-cluster service URL when this integration is enabled."
          },
          "internalTokenSecretRef": {
            "$ref": "#/definitions/secretRef"
          }
        }
      }
    },
    "dq": {
      "allOf": [
        {
          "$ref": "#/definitions/integration"
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "serviceJwtSecretRef",
              "delegationJwtSecretRef"
            ],
            "properties": {
              "serviceJwtSecretRef": {
                "$ref": "#/definitions/secretRef",
                "description": "Secret holding the key that signs the scoped service JWT DQ's validate route requires (W-002). Mounted as DQ_SERVICE_JWT_SECRET; must equal DQ's INBOUND_SERVICE_JWT_SECRET. Outside dev the legacy internal token is never sent, so this is mandatory when DQ is enabled."
              },
              "delegationJwtSecretRef": {
                "$ref": "#/definitions/secretRef",
                "description": "Secret holding the key that signs the short-lived delegated JWT Workspace presents to DQ (X-001). Mounted as DQ_DELEGATION_JWT_SECRET; must equal DQ's DELEGATION_JWT_SECRET. Without it every user-facing DQ call is refused (503), so it is mandatory when DQ is enabled."
              }
            }
          }
        }
      ]
    },
    "secrets": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "backend"
      ],
      "properties": {
        "backend": {
          "enum": [
            "aws_secrets_manager",
            "azure_key_vault",
            "gcp_secret_manager"
          ],
          "description": "Cloud secret manager only \u2014 'local' (plaintext on pod disk) is dev-only and never valid in this chart."
        },
        "pathPrefix": {
          "type": "string",
          "minLength": 1
        },
        "azureVaultUrl": {
          "type": "string"
        },
        "gcpProjectId": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "const": "azure_key_vault"
              }
            }
          },
          "then": {
            "required": [
              "azureVaultUrl"
            ],
            "properties": {
              "azureVaultUrl": {
                "minLength": 1,
                "pattern": "^https://"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "gcp_secret_manager"
              }
            }
          },
          "then": {
            "required": [
              "gcpProjectId"
            ],
            "properties": {
              "gcpProjectId": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "gateway": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mode",
        "internalSecretRef"
      ],
      "properties": {
        "mode": {
          "enum": [
            "trusted-envoy"
          ],
          "description": "How identity reaches Workspace. Only 'trusted-envoy' exists: identity headers from the data-plane gateway, proven by a shared secret."
        },
        "internalSecretRef": {
          "$ref": "#/definitions/secretRef",
          "description": "Secret holding the gateway's shared secret (its ENVOY_INTERNAL_SECRET), mounted as ENVOY_INTERNAL_SECRET."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dataPolicy": {
            "properties": {
              "mode": {
                "const": "enforce"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "dataPolicy"
        ]
      },
      "then": {
        "properties": {
          "ucs": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "ucs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "governance": {
            "properties": {
              "profile": {
                "const": "development-ungoverned"
              }
            },
            "required": [
              "profile"
            ]
          }
        },
        "required": [
          "governance"
        ]
      },
      "then": {
        "properties": {
          "governance": {
            "properties": {
              "acknowledgeUnsupportedForProduction": {
                "const": true
              }
            },
            "required": [
              "acknowledgeUnsupportedForProduction"
            ]
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "governance": {
              "properties": {
                "profile": {
                  "const": "development-ungoverned"
                }
              },
              "required": [
                "profile"
              ]
            }
          },
          "required": [
            "governance"
          ]
        }
      },
      "then": {
        "properties": {
          "ucs": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "ucs"
        ]
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "governance": {
              "properties": {
                "profile": {
                  "const": "development-ungoverned"
                }
              },
              "required": [
                "profile"
              ]
            }
          },
          "required": [
            "governance"
          ]
        }
      },
      "then": {
        "properties": {
          "dataPolicy": {
            "properties": {
              "mode": {
                "enum": [
                  "audit",
                  "enforce"
                ],
                "description": "production-governed does not allow the policy gate to be off."
              }
            }
          }
        }
      }
    }
  ]
}
