{
  "package_version": "1",
  "manifest": {
    "key": "conversational-knowledge",
    "name": "Conversational & Knowledge",
    "version": "1.0.1",
    "type": "App",
    "category": "Service",
    "vertical": null,
    "tags": [],
    "desc": "RAG pipelines, multi-turn memory, citation.",
    "first_party": true,
    "app_type": "chatflow"
  },
  "flow": {
    "nodes": [
      {
        "id": "t1",
        "type": "trigger",
        "x": 40,
        "y": 140,
        "sub": "user input",
        "config": {}
      },
      {
        "id": "t2",
        "type": "gov",
        "x": 200,
        "y": 140,
        "sub": "entitlement gate",
        "config": {}
      },
      {
        "id": "t3",
        "type": "retrieval",
        "x": 360,
        "y": 140,
        "sub": "support KB",
        "config": {
          "knowledge_bases": [],
          "top_k": 5
        }
      },
      {
        "id": "t4",
        "type": "llm",
        "x": 520,
        "y": 140,
        "sub": "RAG answer",
        "config": {
          "mode": "agentic",
          "model": "Claude Haiku 4.5",
          "step_limit": 10,
          "guardrail_profile": "Standard (input + output)"
        }
      },
      {
        "id": "t5",
        "type": "respond",
        "x": 680,
        "y": 140,
        "sub": "chat reply",
        "config": {
          "format": "markdown",
          "streaming": true
        }
      }
    ],
    "edges": [
      {
        "id": "te1",
        "source": "t1",
        "target": "t2",
        "source_handle": null
      },
      {
        "id": "te2",
        "source": "t2",
        "target": "t3",
        "source_handle": null
      },
      {
        "id": "te3",
        "source": "t3",
        "target": "t4",
        "source_handle": null
      },
      {
        "id": "te4",
        "source": "t4",
        "target": "t5",
        "source_handle": null
      }
    ]
  },
  "requirements": {
    "node_types": [
      "gov",
      "llm",
      "respond",
      "retrieval",
      "trigger"
    ],
    "knowledge_bases": [],
    "catalog_objects": [],
    "tools": [],
    "models": [
      "Claude Haiku 4.5"
    ],
    "env_vars": [],
    "review": []
  }
}
