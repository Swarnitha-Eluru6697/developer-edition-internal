# Point DataConnect at one Kafka Connect cluster per worker pool.
#
#   cp infra/pools.env.example infra/.env     # (or export these)
#   docker compose --profile pools up -d --build
#
# The pools' internal topics (_inai_connect_<pool>_{configs,offsets,status}) are created first by connect-topics-init.
# On a cluster of 3+ brokers also set:
#   CONNECT_INTERNAL_REPLICATION_FACTOR=3
#   CONNECT_INTERNAL_MIN_INSYNC_REPLICAS=2
CONNECT_POOLS_JSON={"connect-cdc-pool":"http://connect-cdc:8083","connect-jdbc-pool":"http://connect-jdbc:8083","connect-file-pool":"http://connect-file:8083","connect-api-pool":"http://connect-api:8083","connect-stream-pool":"http://connect-stream:8083","connect-sink-pool":"http://connect-sink:8083"}
