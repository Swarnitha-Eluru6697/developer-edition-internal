{
  "name": "dataconnect-mfe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "InaiEra DataConnect — React/TypeScript/Vite Module Federation remote (data-plane MFE)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gen:api-types": "openapi-typescript ${DATACONNECT_OPENAPI_URL:-http://localhost:8001/openapi.json} --default-non-nullable false -o src/types/dataconnect-api.generated.ts",
    "gen:access-contract": "node scripts/gen-access-contract.mjs",
    "check:access-contract": "node scripts/gen-access-contract.mjs --check",
    "preview": "vite preview --port 5001 --host",
    "serve": "tsx server.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "test:live": "DATACONNECT_LIVE_E2E=1 playwright test --project=live"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "simple-icons": "^16.33.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.4"
  }
}
