# Copy to .env and adjust if your Postgres isn't on localhost with these defaults.
DATABASE_URL=postgres://postgres:postgres@localhost:5438/mlstudio
PORT=4000

# Startup reference data (both default on; only "false" disables):
# SEED_REFERENCE_DATA — upsert algorithm specs + base models, insert missing compute pools.
# SEED_SAMPLE_DATASETS — load the three sample-* datasets once (needs STORAGE_BACKEND).
# Neither ever deletes anything. `npm run seed` is different: dev only, drops every table.
#SEED_REFERENCE_DATA=true
#SEED_SAMPLE_DATASETS=true

# --- Unified Catalog Service (UCS) integration ---
# Rebuilt against the actual uploaded UCS codebase (services/catalog) —
# these match its real, verified API, not assumptions.
#
# UCS_BASE_URL: where the real UCS is reachable.
UCS_BASE_URL=http://localhost:5174
# UCS_MODEL_CATALOG / UCS_MODEL_SCHEMA: the real Gravitino catalog.schema
# ML Studio's models are registered under — a catalog with engine="model"
# must exist in UCS for this to work (see scripts/bootstrapUcs.ts).
UCS_MODEL_CATALOG=ml_models
UCS_MODEL_SCHEMA=default
# UCS_TENANT_ID: sent as X-Tenant-Id on every header-authenticated call
# (authz/check, lineage, user/* reads) — identity.py falls back to
# GRAVITINO_METALAKE if this header is absent, so it should normally
# match your UCS deployment's metalake name.
UCS_TENANT_ID=ml_models

# --- Workflow execution (Pipelines) ---
# If unset, pipeline restarts run on a real local executor (genuinely
# progresses stages over real time, verifiable with no external cluster).
# Set these to use a real Argo Workflows server instead:
ARGO_SERVER_URL=
ARGO_TOKEN=
ARGO_NAMESPACE=default

# --- Model serving (Deploy & Promote, Endpoints) ---
# SERVING_MODE=production makes local inference fail closed: missing,
# corrupt or unloadable model artifacts return 5xx and NEVER fall back to
# the deterministic development stand-in. If unset, NODE_ENV=production
# also selects production serving; otherwise development mode is used.
SERVING_MODE=
# Set these to use real KServe instead:
KSERVE_API_URL=
KUBE_TOKEN=
KSERVE_NAMESPACE=default
# Used to build the local serving URL returned on promotion — defaults to
# http://localhost:$PORT if unset.
PUBLIC_HOST=

# --- Object storage (customer-configurable: S3, ADLS, or GCS) ---
# ML Studio runs inside the customer data plane already, alongside
# Gravitino/Trino/Flink — it reads/writes the customer'''s own bucket
# directly, the same way those do. This is genuinely different from
# Model Import Service'''s job (a separate, InAiEra-run tool that copies
# base-model weights INTO this bucket from outside — see
# model-import-service/README.md): ML Studio never reaches outside the
# data plane, it just uses the bucket that'''s already local to it.
#
# Where real base-model weights land once imported, and where newly
# trained models' real weight files get uploaded. In production (or when
# ARTIFACT_PERSISTENCE_MODE=required / REQUIRE_DURABLE_ARTIFACTS=true),
# training FAILS if the artifact cannot be uploaded and verified, and
# promotion/rollback reject versions whose artifact is not durably present.
# In development only, storage may remain unset and a non-deployable
# challenger version can still be created for UI/demo workflows.
ARTIFACT_PERSISTENCE_MODE=
REQUIRE_DURABLE_ARTIFACTS=false
STORAGE_BACKEND=
# --- s3 ---
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT / S3_FORCE_PATH_STYLE: local/self-hosted S3-compatible
# testing only (moto, MinIO) — leave both unset for real AWS.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# --- adls (Azure Data Lake Storage Gen2 — accessed via the Blob data-plane API) ---
ADLS_CONTAINER=
ADLS_ACCOUNT_NAME=
ADLS_ACCOUNT_KEY=
ADLS_CONNECTION_STRING=
# --- gcs ---
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_KEY_FILENAME=
GCS_CREDENTIALS_JSON=

# LLM fine-tuning ceiling in ms (default 30 min). 2592000000 = 30 days.
# LLM_FINETUNE_TIMEOUT_MS=2592000000

# ---- Authorisation (docs/auth/01-CONTRACT.md) ----
# Every route except /api/health answers 401 unless the request came through
# Envoy: TRUST_ENVOY_HEADERS=true AND x-inaiera-gateway-secret equal to
# ENVOY_INTERNAL_SECRET. Permissions come from Envoy's x-user-permissions
# header (permission IDs in permissions.json); there are no roles in this app.
TRUST_ENVOY_HEADERS=false
ENVOY_INTERNAL_SECRET=
# UCS's own gateway secret, sent on every ML Studio call to UCS.
UCS_GATEWAY_SECRET=
# ML Studio's service name towards UCS. Service calls carry it with exactly the
# UCS permission they need: lineage events -> ucs:lineage-events:create; admin
# registration/RBAC -> ucs:catalogs:manage,ucs:rbac:manage. No bearer token or
# role is sent. Calls for a signed-in user carry that user's name/id/groups.
UCS_SERVICE_USERNAME=ml-studio-service
# Optional, comma-separated: UCS groups the service's object grants are bound to.
UCS_SERVICE_GROUPS=
