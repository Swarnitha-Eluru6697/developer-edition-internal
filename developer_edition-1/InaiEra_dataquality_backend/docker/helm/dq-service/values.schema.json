{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "inaiera-data-quality values",
  "description": "DQ-CFG-001: explicit per-integration URL + own signing-secret reference, required whenever the integration is enabled; container hardening that cannot be weakened.",
  "type": "object",
  "required": ["tenant", "integrations", "database", "podSecurityContext", "securityContext", "qualityContract"],
  "properties": {
    "tenant": {
      "type": "object",
      "required": ["orgId"],
      "properties": {"orgId": {"type": "string", "minLength": 1}}
    },
    "environment": {"enum": ["dev", "staging", "prod"]},
    "database": {
      "type": "object",
      "required": ["host", "port", "name", "user", "passwordSecretRef"],
      "properties": {"passwordSecretRef": {"$ref": "#/definitions/secretRef"}}
    },
    "integrations": {
      "type": "object",
      "required": ["ucs", "dbtRunner", "flinkRunner"],
      "additionalProperties": false,
      "properties": {
        "ucs": {"$ref": "#/definitions/integration"},
        "dbtRunner": {"$ref": "#/definitions/integration"},
        "flinkRunner": {"$ref": "#/definitions/integration"}
      }
    },
    "qualityContract": {
      "type": "object",
      "required": ["version", "resultsTopic", "gateTopic", "quarantineTopic"],
      "properties": {"version": {"const": "2.0"}}
    },
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot", "seccompProfile"],
      "properties": {
        "runAsNonRoot": {"const": true},
        "runAsUser": {"type": "integer", "minimum": 1},
        "seccompProfile": {
          "type": "object", "required": ["type"],
          "properties": {"type": {"enum": ["RuntimeDefault", "Localhost"]}}
        }
      }
    },
    "securityContext": {
      "type": "object",
      "required": ["runAsNonRoot", "allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities", "seccompProfile"],
      "properties": {
        "runAsNonRoot": {"const": true},
        "allowPrivilegeEscalation": {"const": false},
        "readOnlyRootFilesystem": {"const": true},
        "privileged": {"const": false},
        "capabilities": {
          "type": "object", "required": ["drop"],
          "properties": {
            "drop": {"type": "array", "contains": {"const": "ALL"}},
            "add": {"type": "array", "maxItems": 0}
          }
        },
        "seccompProfile": {
          "type": "object", "required": ["type"],
          "properties": {"type": {"enum": ["RuntimeDefault", "Localhost"]}}
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}}
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"type": ["integer", "string"]}}
    }
  },
  "definitions": {
    "secretRef": {
      "type": "object",
      "required": ["name", "key"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "integration": {
      "type": "object",
      "required": ["enabled", "url", "audience", "serviceJwtSecret"],
      "properties": {
        "enabled": {"type": "boolean"},
        "url": {"type": "string"},
        "audience": {"type": "string", "minLength": 1},
        "serviceJwtSecret": {
          "type": "object",
          "properties": {"name": {"type": "string"}, "key": {"type": "string"}}
        }
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {
        "properties": {
          "url": {"type": "string", "pattern": "^https?://[^/\\s]+"},
          "serviceJwtSecret": {"$ref": "#/definitions/secretRef"}
        }
      }
    }
  }
}
