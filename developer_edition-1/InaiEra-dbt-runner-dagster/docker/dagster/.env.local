# ---------------------------------------------------------------------------
# Local development environment for the Dagster stack.
# Copy to .env in the same directory (cp .env.local .env), then run from the repo root:
#   docker compose -f docker/dagster/docker-compose.yml up -d --build
# ---------------------------------------------------------------------------

# --- Dagster metadata DB (local Postgres started by docker-compose) ---------
DAGSTER_PG_HOST=dagster-db
DAGSTER_PG_PORT=5432
DAGSTER_PG_DB=dagster
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=dagster

# --- Dagster storage paths (inside the container) ---------------------------
DAGSTER_COMPUTE_LOGS_DIR=/var/lib/dagster/compute-logs
DAGSTER_ARTIFACTS_DIR=/var/lib/dagster/artifacts

# --- Code server location (used by workspace.yaml) --------------------------
DAGSTER_CODE_SERVER_HOST=dagster-code
DAGSTER_CODE_SERVER_PORT=4000

# --- dbt Runner API (Dagster sensors call this) -----------------------------
DBT_RUNNER_BASE_URL=http://host.docker.internal:8082

# Dagster's own scoped identity at the runner (DBT-003): every request carries a fresh short-lived JWT signed
# with this key. Must equal SCHEDULER_JWT_SECRET in the dbtrunner container (its compose default is the
# value below) and ORG_ID must equal the runner's ORG_ID. The runner's static INTERNAL_SERVICE_TOKEN is no
# longer used by Dagster (it opens only the runner's /validate route).
SCHEDULER_JWT_SECRET=local-dev-dbtrunner-scheduler-secret
ORG_ID=local-dev

# --- Deployment target -------------------------------------------------------
# Controls resource config in definitions.py  ("local" uses env defaults)
DAGSTER_DEPLOYMENT_TARGET=local
