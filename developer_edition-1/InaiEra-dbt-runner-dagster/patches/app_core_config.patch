--- a/app/core/config.py
+++ b/app/core/config.py
@@ -95,6 +95,17 @@ class Settings(BaseSettings):
     # Leader election: one process (across replicas AND uvicorn workers)
     # runs the scheduler / reconciler / outbox loops.
     leader_election_retry_seconds: int = 10
+
+    # --- Dagster integration (Phase 2) ---
+    # Set to False when Dagster's project_schedule_sensor owns scheduling.
+    # The built-in scheduler_loop is excluded from the leader task list so
+    # Dagster and the native scheduler cannot both fire the same occurrence.
+    # The run reconciler and metadata outbox always run regardless of this
+    # flag — they manage in-flight runs and durable event delivery, neither
+    # of which is Dagster's responsibility.
+    # ScheduledOccurrence rows are still written by Dagster's trigger_and_poll
+    # op (via POST /api/v1/projects/{id}/run?trigger=scheduled) so the
+    # UNIQUE(project_id, scheduled_fire_time) dedup constraint remains active.
+    scheduler_enabled: bool = Field(default=True, alias="SCHEDULER_ENABLED")

     # --- Metadata outbox (RUN-DBT-008) ---
     metadata_outbox_poll_interval_seconds: int = 15
